{
  "name": "haohaotiantian-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 + Vite rewrite of the Haohaotiantian frontend (水浒传 redesign). Built alongside the Vue 2 app in this repo until cutover.",
  "scripts": {
    "dev": "vite",
    "build:staging": "vite build --mode staging",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:cutover": "node scripts/check-cutover.mjs",
    "lint": "eslint . --ext .js,.vue",
    "test:pwa": "playwright test -c playwright.pwa.config.js"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.12",
    "axios": "^1.7.9",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.61.1",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  }
}
